{
  "name": "@cabal/server",
  "version": "0.1.0",
  "private": true,
  "description": "Cabal API worker and GameRoom Durable Object",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test",
    "test": "vitest run --passWithNoTests",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "engine:sync": "node scripts/sync-wasm.mjs",
    "predev": "node scripts/sync-wasm.mjs",
    "prebuild": "node scripts/sync-wasm.mjs",
    "pretest": "node scripts/sync-wasm.mjs",
    "predeploy": "node scripts/sync-wasm.mjs"
  },
  "dependencies": {
    "@cabal/engine": "workspace:*",
    "@cabal/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261026.1",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
