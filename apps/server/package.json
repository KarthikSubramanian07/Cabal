{
  "name": "@cabal/server",
  "version": "0.1.0",
  "private": true,
  "description": "Cabal API worker and GameRoom Durable Object",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test",
    "test": "vitest run && node --test scripts/build-id.test.mjs",
    "load:sockets": "node scripts/load-sockets.mjs",
    "cold-start": "node scripts/sync-wasm.mjs && node scripts/cold-start.mjs",
    "metrics:datc": "node scripts/report-datc.mjs",
    "deploy": "node scripts/deploy.mjs",
    "cf-typegen": "wrangler types",
    "engine:sync": "node scripts/sync-wasm.mjs",
    "db:migrate": "wrangler d1 migrations apply cabal --remote",
    "db:migrate:local": "wrangler d1 migrations apply cabal --local",
    "predev": "node scripts/sync-wasm.mjs && wrangler d1 migrations apply cabal --local",
    "prebuild": "node scripts/sync-wasm.mjs",
    "pretest": "node scripts/sync-wasm.mjs",
    "predeploy": "node scripts/sync-wasm.mjs"
  },
  "dependencies": {
    "@cabal/agents": "workspace:*",
    "@cabal/engine": "workspace:*",
    "@cabal/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
