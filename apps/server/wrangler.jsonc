{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cabal-server",
  "account_id": "e5e342f3ca2f33158f6f1dd40c039be0",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // The Worker version id: what /health and error logs report as the build when BUILD_ID is unset.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      // Single-writer state that needs strict serial order (the deployment-wide Claude budget), and
      // the games index from before D1. One instance, addressed as idFromName("global").
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  // The cross-game index: finished games, public listings, players, ratings and the trust ledger.
  // Schema: the numbered files in migrations/, applied with `wrangler d1 migrations apply cabal`.
  "d1_databases": [
    { "binding": "DB", "database_name": "cabal", "database_id": "74b92351-31ff-4b12-947f-1d5370a28218", "migrations_dir": "migrations" }
  ],
  // Durable Object class migrations. Append a tag; never edit one that has been deployed.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ],
  // Abuse limits (period must be 10 or 60 seconds). Create, join, read and account creation are
  // keyed by client address; press by game and seat inside the room; account changes by player.
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "4801", "simple": { "limit": 10, "period": 60 } },
    { "name": "JOIN_LIMITER", "namespace_id": "4802", "simple": { "limit": 30, "period": 60 } },
    { "name": "PRESS_LIMITER", "namespace_id": "4803", "simple": { "limit": 60, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "4804", "simple": { "limit": 300, "period": 60 } },
    // Creating a guest account and restoring one from a recovery code, keyed by client address.
    { "name": "ACCOUNT_LIMITER", "namespace_id": "4805", "simple": { "limit": 10, "period": 60 } },
    // Changes to an account (rename, new recovery code, sign out), keyed by player.
    { "name": "PROFILE_LIMITER", "namespace_id": "4806", "simple": { "limit": 20, "period": 60 } }
  ],
  // Claude turns for games that opt into `aiBrain: "claude"`. The built-in bot never uses the queue.
  // One message is one model call: small batches, bounded concurrency (two full tables of six seats
  // can think at once; spend is bounded per game by the room and for the whole deployment by the
  // Registry's daily budget, not here), and a dead-letter queue so
  // a turn that cannot be delivered is visible instead of silently dropped.
  "queues": {
    "producers": [{ "binding": "AGENT_QUEUE", "queue": "cabal-agent-turns" }],
    "consumers": [
      {
        "queue": "cabal-agent-turns",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "max_concurrency": 12,
        "dead_letter_queue": "cabal-agent-turns-dlq"
      }
    ]
  }
}
