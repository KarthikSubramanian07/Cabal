{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cabal-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  // Per-IP abuse limits on the two unauthenticated write routes (period must be 10 or 60 seconds).
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "4801", "simple": { "limit": 10, "period": 60 } },
    { "name": "JOIN_LIMITER", "namespace_id": "4802", "simple": { "limit": 30, "period": 60 } },
    { "name": "PRESS_LIMITER", "namespace_id": "4803", "simple": { "limit": 60, "period": 60 } }
  ],
  // Create this D1 database and replace the placeholder ID before deployment.
  "d1_databases": [
    { "binding": "DB", "database_name": "cabal-cross-game", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // Create the queue with `wrangler queues create cabal-agent-turns` before deployment.
  "queues": {
    "producers": [{ "binding": "AGENT_QUEUE", "queue": "cabal-agent-turns" }],
    "consumers": [{ "queue": "cabal-agent-turns", "max_batch_size": 1, "max_retries": 5 }]
  }
}
