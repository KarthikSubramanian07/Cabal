{
  "name": "@cabal/web",
  "version": "0.1.0",
  "private": true,
  "description": "Cabal web client",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cabal/engine": "workspace:*",
    "@cabal/protocol": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.83.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.132.0",
    "@types/node": "^24.6.0"
  }
}
