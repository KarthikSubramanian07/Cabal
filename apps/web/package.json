{
  "name": "@cabal/web",
  "version": "0.1.0",
  "private": true,
  "description": "Cabal web client",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/emit-agent-site.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "pages": "pnpm build && wrangler pages dev dist --port 8788",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "assets": "node scripts/assets.mjs",
    "emit:agent-site": "node scripts/emit-agent-site.mjs"
  },
  "dependencies": {
    "@cabal/engine": "workspace:*",
    "@cabal/protocol": "workspace:*",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.1",
    "oxlint": "^1.89.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.148.0"
  }
}
